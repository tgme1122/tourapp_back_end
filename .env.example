ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sayohatapp
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Production muhitida frontend domenlarni ko'rsating (JSON ro'yxat):
# CORS_ORIGINS=["https://app.sayohatapp.uz","https://admin.sayohatapp.uz"]
CORS_ORIGINS=[]
ALLOW_LOCAL_CORS=true

PUBLIC_BASE_URL=http://localhost:8000
MEDIA_DIR=media
PRIVATE_DIR=private

# Fernet kaliti: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSPORT_ENCRYPTION_KEY=change-this-to-a-fernet-key
BOOKING_HOLD_MINUTES=10

# Production muhitida ALWAYS false bo'lishi shart
PAYMENT_SIMULATION=false
